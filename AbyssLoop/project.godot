; Engine configuration file.
; Generated for Godot 4.x. Content stays data-driven; original abyss pixel-art theme.
config_version=5

[application]

config/name="Abyss Loop"
config/version="0.61.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]
ContentRegistry="*res://scripts/core/content_registry.gd"
SaveSystem="*res://scripts/core/save_system.gd"
GameState="*res://scripts/core/game_state.gd"
Localization="*res://scripts/core/localization.gd"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/size/min_width=1180
window/size/min_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.055, 0.078, 0.086, 1)

